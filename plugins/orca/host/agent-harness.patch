@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict'
+import { afterEach, test } from 'node:test'
+import {
+  assertHostAgentHarnessEnabled,
+  bindAgentHarnessInventory,
+  hostAgentHarnessEnabled,
+  waitForAgentHarnessDiscovery
+} from './bqagent-plugin-harness.ts'
+import { StructuredAgentRegistry } from '../native-chat/agent-session-wire/providers/structured-agent-registry.ts'
+
+const harness = { id: 'bqagent', command: 'bqagent', args: ['--acp'] }
+const declaration = (pluginKey, id = 'bqagent', entries = [harness]) => ({
+  pluginKey,
+  manifest: { id, contributes: { agentHarnesses: entries } }
+})
+afterEach(() => bindAgentHarnessInventory(() => null))
+
+test('a live host registry admits an approved harness and refuses it after revocation', async () => {
+  const installed = declaration('local.bqagent')
+  const grants = new Map()
+  const plugins = []
+  let ready = false
+  bindAgentHarnessInventory(() => ({
+    whenReady: async () => { ready = true },
+    getDiscovered: () => plugins,
+    getGrantedCapabilities: (key) => grants.get(key) ?? null
+  }))
+  const registration = (agent) => ({ definition: { agent, capabilities: {} }, adapter: {} })
+  const bq = registration('bqagent')
+  const grok = registration('grok')
+  const registry = new StructuredAgentRegistry([bq, grok], hostAgentHarnessEnabled)
+  await waitForAgentHarnessDiscovery()
+  assert.equal(ready, true)
+  assert.deepEqual(registry.definitions(), [grok.definition])
+  plugins.push(installed)
+  grants.set('other.bqagent', ['agent:launch'])
+  assert.equal(registry.registration('bqagent'), null)
+  grants.set(installed.pluginKey, ['agent:read'])
+  assert.equal(registry.registration('bqagent'), null)
+  grants.set(installed.pluginKey, ['agent:launch'])
+  assert.equal(registry.registration('bqagent'), bq)
+  assert.doesNotThrow(() => assertHostAgentHarnessEnabled('bqagent'))
+  grants.delete(installed.pluginKey)
+  assert.equal(registry.capabilities('bqagent'), null)
+  assert.throws(() => assertHostAgentHarnessEnabled('bqagent'), /approve/)
+  grants.set(installed.pluginKey, ['agent:launch'])
+  plugins.length = 0
+  assert.equal(registry.registration('bqagent'), null)
+  assert.equal(registry.registration('grok'), grok)
+})
+
+test('approval cannot activate another ID, invalid manifest, command or argument list', () => {
+  for (const candidate of [
+    { pluginKey: 'local.bqagent', error: 'invalid' },
+    declaration('local.other', 'other'),
+    declaration('local.bqagent', 'bqagent', []),
+    ...[
+      { ...harness, id: 'other' },
+      { ...harness, command: '/tmp/bqagent' },
+      { ...harness, args: ['--acp', '--extra'] },
+      { ...harness, args: [] },
+      { ...harness, args: null }
+    ].map((row) => declaration('local.bqagent', 'bqagent', [row]))
+  ]) {
+    bindAgentHarnessInventory(() => ({
+      getDiscovered: () => [candidate],
+      getGrantedCapabilities: () => ['agent:launch']
+    }))
+    assert.equal(hostAgentHarnessEnabled('bqagent'), false)
+  }
+  bindAgentHarnessInventory(() => null)
+  assert.equal(hostAgentHarnessEnabled('bqagent'), false)
+  assert.equal(hostAgentHarnessEnabled('grok'), true)
+})
diff --git a/src/main/bqagent/bqagent-plugin-harness.ts b/src/main/bqagent/bqagent-plugin-harness.ts
new file mode 100644
index 0000000..5db5cc0
--- /dev/null
+++ b/src/main/bqagent/bqagent-plugin-harness.ts
@@ -0,0 +1,49 @@
+import type { PluginService } from '../plugins/plugin-service'
+
+type HarnessInventory = Pick<PluginService, 'getDiscovered' | 'getGrantedCapabilities' | 'whenReady'>
+let inventory: () => HarnessInventory | null = () => null
+
+/** Only the composition root supplies the executing host's inventory. CLI-only hosts fail closed. */
+export function bindAgentHarnessInventory(read: () => HarnessInventory | null): void {
+  inventory = read
+}
+
+/** The first registered-agent response is cached by clients for the lifetime of this runtime. */
+export async function waitForAgentHarnessDiscovery(): Promise<void> {
+  await inventory()?.whenReady()
+}
+
+/** Match a reviewed declaration to a host-owned spec. Never execute manifest command text. */
+export function hostAgentHarnessEnabled(agent: string): boolean {
+  if (agent !== 'bqagent') {
+    return true
+  }
+  const service = inventory()
+  if (!service) {
+    return false
+  }
+  return service.getDiscovered().some((plugin) => {
+    if (!('manifest' in plugin) || plugin.manifest.id !== 'bqagent') {
+      return false
+    }
+    const harnesses = plugin.manifest.contributes?.agentHarnesses
+    const harness = harnesses?.[0]
+    return (
+      harnesses?.length === 1 &&
+      harness?.id === 'bqagent' &&
+      harness.command === 'bqagent' &&
+      Array.isArray(harness.args) &&
+      harness.args.length === 1 &&
+      harness.args[0] === '--acp' &&
+      service.getGrantedCapabilities(plugin.pluginKey)?.includes('agent:launch') === true
+    )
+  })
+}
+
+export function assertHostAgentHarnessEnabled(agent: string): void {
+  if (!hostAgentHarnessEnabled(agent)) {
+    throw new Error(
+      'Enable the bqagent plugin and approve its agent:launch permission to use bqagent chat.'
+    )
+  }
+}
