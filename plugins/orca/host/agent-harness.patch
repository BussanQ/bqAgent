+  hostAgentHarnessEnabled: vi.fn(),
+  waitForAgentHarnessDiscovery: vi.fn()
+}))
+
+afterEach(() => {
+  vi.resetAllMocks()
+})
+
+it('probes bqagent only with host approval and never counts an alternate command', async () => {
+  let enabled = false
+  const binary = 'alternate-binary'
+  vi.mocked(hostAgentHarnessEnabled).mockImplementation((id) => id !== 'bqagent' || enabled)
+  const probe = vi.mocked(detectAgentCommandsOnHost)
+  probe.mockResolvedValue(new Set(['grok', 'bqagent', binary]))
+  const options = { agentCmdOverrides: { bqagent: binary } }
