+import type { AcpLaunchSpec } from '../acp/launch/acp-launch-contract'
+import { GENERIC_ACP_DIALECT } from '../acp/acp-dialects/acp-dialect'
+import { directoryAccountBinding } from '../acp/launch/acp-account-binding'
+import { resumeInvocationFromOptions } from '../native-chat/conversation-adoption/structured-agent-cli-conversations'
+
+export const BQAGENT_LAUNCH_SPEC: AcpLaunchSpec = {
+  agent: 'bqagent',
+  command: 'bqagent',
+  args: () => ['--acp'],
+  env: {},
+  dialect: GENERIC_ACP_DIALECT,
+  loginCommand: [],
+  // bqagent reads ~/.agent through the OS user home, with no separate account-home override.
+  account: directoryAccountBinding(
+    'HOME',
+    (homePath, env) => env.USERPROFILE?.trim() || homePath
+  ),
+  installDirectories: () => [],
+  ownApprovalMode: true,
+  imagePrompts: false,
+  modelDiscovery: {
+    kind: 'unavailable',
+    reason: 'bqagent reports models in live chats; discovery cannot delete its persistent sessions.'
+  },
+  keepsEverySession: true,
+  transcriptImport: null,
+  sessionHistory: {
+    rowAgents: ['bqagent'],
+    rowSessionId: (link) => link.handle.nativeId,
+    parseResumeArgs: (args) =>
+      resumeInvocationFromOptions(args, { targetless: [], markers: ['--resume'] })
+  }
+}
