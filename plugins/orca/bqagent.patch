diff --git a/src/main/acp/session/acp-structured-bqagent.test.ts b/src/main/acp/session/acp-structured-bqagent.test.ts
new file mode 100644
index 0000000..ad3761f
--- /dev/null
+++ b/src/main/acp/session/acp-structured-bqagent.test.ts
@@ -0,0 +1,147 @@
+import { afterEach, expect, it } from 'vitest'
+import { BQAGENT_LAUNCH_SPEC } from '../../bqagent/bqagent-acp-launch-spec'
+import {
+  closeProviderTimelineRigs,
+  SESSION
+} from '../../native-chat/agent-session-timeline/provider-timeline-assembler-test-support'
+import {
+  openAcpAdapterRig,
+  PROVIDER_SESSION,
+  sendHello
+} from './testing/acp-structured-adapter.test-support'
+
+const models = {
+  currentModelId: 'model-a',
+  availableModels: [
+    { modelId: 'model-a', name: 'Model A' },
+    { modelId: 'model-b', name: 'Model B' }
+  ]
+}
+
+const configOptions = [
+  {
+    id: 'model',
+    name: 'Model',
+    category: 'model',
+    type: 'select',
+    currentValue: 'model-a',
+    options: [
+      { value: 'model-a', name: 'Model A' },
+      { value: 'model-b', name: 'Model B' }
+    ]
+  }
+]
+
+afterEach(closeProviderTimelineRigs)
+
+it.each([false, true])('opens bqagent with own approvals (resume=%s)', async (resume) => {
+  const rig = await openAcpAdapterRig({
+    spec: BQAGENT_LAUNCH_SPEC,
+    launch: {
+      resume: resume
+        ? {
+            sessionId: PROVIDER_SESSION,
+            key: 'acp:bqagent:acp-session-1',
+            mayBeUnsaved: async () => false,
+            lossKeys: []
+          }
+        : null
+    },
+    script: (agent) => {
+      agent.on('session/set_config_option', (frame) =>
+        agent.reply(frame, {
+          configOptions: [{ ...configOptions[0], currentValue: 'model-b' }]
+        })
+      )
+      agent.on('session/new', (frame) =>
+        agent.reply(frame, { sessionId: PROVIDER_SESSION, models, configOptions })
+      )
+      agent.on('session/load', (frame) => {
+        agent.notify('session/update', {
+          sessionId: PROVIDER_SESSION,
+          update: {
+            sessionUpdate: 'agent_message_chunk',
+            content: { type: 'text', text: 'previous answer' }
+          }
+        })
+        agent.reply(frame, { models, configOptions })
+      })
+    }
+  })
+  await rig.acquire()
+  expect(rig.started().reportedOptions).toMatchObject({
+    model: 'model-a',
+    reportedPermissionMode: 'own'
+  })
+  expect(rig.started().link.handle).toEqual({
+    transport: 'acp',
+    agent: 'bqagent',
+    nativeId: 'acp-session-1'
+  })
+  expect(rig.sent('session/set_config_option')).toEqual([])
+  expect(rig.sent('session/resume')).toEqual([])
+  if (resume) {
+    expect(rig.sent('session/load')[0].params).toMatchObject({ sessionId: 'acp-session-1' })
+    expect(rig.sent('session/new')).toEqual([])
+    expect(await rig.rig.rows()).toEqual([])
+  }
+  expect(
+    await rig.adapter.setOption({ sessionId: SESSION, fence: 1, key: 'model', value: 'model-b' })
+  ).toEqual({ model: 'model-b' })
+  expect(rig.sent('session/set_config_option')[0].params).toMatchObject({
+    configId: 'model',
+    value: 'model-b'
+  })
+  await rig.adapter.closeSession(SESSION)
+})
+
+it('uses set_model when bqagent only advertises models', async () => {
+  const rig = await openAcpAdapterRig({
+    spec: BQAGENT_LAUNCH_SPEC,
+    script: (agent) => {
+      agent.on('session/new', (frame) =>
+        agent.reply(frame, { sessionId: PROVIDER_SESSION, models })
+      )
+      agent.on('session/set_model', (frame) => agent.reply(frame, {}))
+    }
+  })
+  await rig.acquire()
+  expect(
+    await rig.adapter.setOption({ sessionId: SESSION, fence: 1, key: 'model', value: 'model-b' })
+  ).toEqual({ model: 'model-b' })
+  expect(rig.sent('session/set_model')[0].params).toMatchObject({ modelId: 'model-b' })
+  await rig.adapter.closeSession(SESSION)
+})
+
+it.each(['ask', 'full-access'] as const)('rejects bqagent %s before spawning', async (mode) => {
+  const rig = await openAcpAdapterRig({ spec: BQAGENT_LAUNCH_SPEC })
+  await expect(rig.acquire({ permissionMode: mode })).rejects.toThrow(
+    'bqagent only supports its own approval policy'
+  )
+  expect(rig.spawned).toEqual([])
+})
+
+it.each([false, true])(
+  'cancels unexpected bqagent permission requests without manual approval (fullAccess=%s)',
+  async (fullAccess) => {
+    const rig = await openAcpAdapterRig({ spec: BQAGENT_LAUNCH_SPEC, launch: { fullAccess } })
+    await rig.acquire({ permissionMode: 'own' })
+    await sendHello(rig, 'bq-turn')
+    const prompt = await rig.frame('session/prompt')
+    const { agent } = rig.child()
+    expect(
+      await agent.request(9, 'session/request_permission', {
+        sessionId: PROVIDER_SESSION,
+        toolCall: { toolCallId: 'call-1', title: 'Write file' },
+        options: [{ optionId: 'allow', name: 'Allow', kind: 'allow_once' }]
+      })
+    ).toMatchObject({ result: { outcome: { outcome: 'cancelled' } } })
+    expect((await rig.rig.rows()).filter((row) => row.body.kind === 'approval')).toEqual([])
+    agent.on('session/cancel', () => agent.reply(prompt, { stopReason: 'cancelled' }))
+    await expect(rig.adapter.cancelTurn({ sessionId: SESSION, fence: 1 })).resolves.toEqual({
+      cancelled: true
+    })
+    expect(rig.sent('session/cancel')[0].params).toMatchObject({ sessionId: 'acp-session-1' })
+    await rig.adapter.closeSession(SESSION)
+  }
+)
