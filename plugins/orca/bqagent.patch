diff --git a/src/main/bqagent/bqagent-acp-launch-spec.test.ts b/src/main/bqagent/bqagent-acp-launch-spec.test.ts
new file mode 100644
index 0000000..49f95d3
--- /dev/null
+++ b/src/main/bqagent/bqagent-acp-launch-spec.test.ts
@@ -0,0 +1,62 @@
+import { expect, it } from 'vitest'
+import { acpLaunchSpecFor } from '../acp/launch/acp-launch-registry'
+import { acpStructuredAgentDefinition } from '../acp/session/acp-structured-agent-definitions'
+import { acpModelListingForRelease } from '../acp/discovery/acp-model-discovery-policy'
+import { isTuiAgent, TUI_AGENT_CONFIG } from '../../shared/agent-launch/catalog/tui-agent-config'
+import { newChatPermissionModeForSettings } from '../../shared/agent-launch/permissions/agent-chat-permission-mode'
+import { agentPermissionChoices } from '../../shared/agent-launch/permissions/tui-agent-permission-choice'
+import { BQAGENT_LAUNCH_SPEC } from './bqagent-acp-launch-spec'
+
+it('registers bqagent chat with its own approvals and without unsupported capabilities', () => {
+  const spec = acpLaunchSpecFor('bqagent')!
+  expect(isTuiAgent(spec.agent)).toBe(true)
+  expect(spec.args({ fullAccess: false, pluginDir: null })).toEqual(['--acp'])
+  expect(TUI_AGENT_CONFIG.bqagent.launchCmd).toBe('bqagent')
+  expect(acpStructuredAgentDefinition(spec).capabilities).toMatchObject({
+    approvalEnforcement: 'provider',
+    imagePrompts: false,
+    compact: false,
+    rewind: false
+  })
+  expect(acpStructuredAgentDefinition(spec).capabilities.fork).toBeUndefined()
+  expect(agentPermissionChoices('bqagent')).toEqual(['own'])
+  expect(
+    newChatPermissionModeForSettings('bqagent', { agentPermissionDefault: 'ask' })
+  ).toBeNull()
+  expect(acpModelListingForRelease(spec.modelDiscovery, null)).toBeNull()
+})
+
+it('pins bqagent to the OS user home while retaining the launch environment', async () => {
+  const variable = 'HOME'
+  const homePath = process.platform === 'win32' ? 'C:\\Users\\bq-user' : '/home/bq-user'
+  const home = await BQAGENT_LAUNCH_SPEC.account.resolve({
+    launchEnv: { [variable]: homePath, USERPROFILE: '/other-home' },
+    stateDirectory: '/unused-orca-state'
+  })
+  expect(home).toEqual({ variable, path: homePath })
+  expect(
+    await BQAGENT_LAUNCH_SPEC.account.resolve({
+      launchEnv: { USERPROFILE: homePath },
+      stateDirectory: '/unused-orca-state'
+    })
+  ).toEqual({ variable: 'HOME', path: homePath })
+  expect(
+    BQAGENT_LAUNCH_SPEC.account.environment(home, {
+      PATH: '/user/bin',
+      API_KEY: 'test-key',
+      [variable]: '/changed-home'
+    })
+  ).toEqual({ PATH: '/user/bin', API_KEY: 'test-key', [variable]: homePath })
+})
+
+it('recognizes bqagent native resume ids without inventing continue support', () => {
+  const history = BQAGENT_LAUNCH_SPEC.sessionHistory
+  expect(history.parseResumeArgs(['--resume', 'native-session-7'])).toEqual({
+    target: 'native-session-7'
+  })
+  expect(history.parseResumeArgs(['--resume=native-session-7'])).toEqual({
+    target: 'native-session-7'
+  })
+  expect(history.parseResumeArgs(['--continue'])).toBeNull()
+  expect(history.parseResumeArgs(['--acp'])).toBeNull()
+})
